# Binary files must be declared, otherwise on Windows with core.autocrlf=true
# clone / checkout applies LF→CRLF conversion and the files get corrupted outright.
# Git's automatic binary detection samples the first few KB for NUL bytes, so formats like PDF
# whose headers are mostly ASCII get misdetected as text.

# 3D and manufacturing
*.stl   binary
*.stp   binary
*.step  binary
*.STEP  binary
*.3mf   binary
*.gbr   binary

# Images
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp4   binary
*.webp  binary
*.ico   binary

# Documents and packaging
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.xlsx  binary
*.docx  binary

# EDA projects
*.eprj2 binary
*.epro2 binary
*.sh text eol=lf
# systemd units are copied straight onto the board; CRLF makes systemd misread them
*.service text eol=lf
*.ps1 text eol=crlf
# Files executed directly on the duck, or read by systemd / sudo / sshd / NetworkManager: always LF.
# Extensionless scripts (#!/usr/bin/python3), sudoers and *.conf break at boot if they become CRLF,
# and the replica image build script also rejects overlays containing CR (see software/image/README.md).
software/image/overlay/**        text eol=lf
software/image/calib/**          text eol=lf
software/image/tests/fixtures/** text eol=lf
software/studio/deploy/**        text eol=lf
software/studio/run.py           text eol=lf

# A7Z Python, shell, systemd and patch sources are installed on Linux.
radxa-cubie-a7z/** text eol=lf
