# /etc/sudoers.d/microduck-studio (root:root 0440). Before installing: visudo -cf this file.
# Only allows the helper's one full path; the helper validates its fixed verbs itself (including calib-read / calib-commit / imu-recalibrate), and arguments go through stdin. sudo defaults to env_reset, so the caller's environment variables are not carried over.
# During the trial Studio runs as radxa (studio-trial); later switch to the dedicated user microduck-studio by swapping which of the two lines below is commented out.
radxa ALL=(root) NOPASSWD: /usr/local/sbin/microduck-helper
#microduck-studio ALL=(root) NOPASSWD: /usr/local/sbin/microduck-helper
