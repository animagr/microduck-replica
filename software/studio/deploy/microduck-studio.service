# Microduck Studio autostart at boot (decided by the user on 10-20: no more temporary studio-trial via systemd-run).
# Install: sudo install -m 644 microduck-studio.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now microduck-studio
# Remove: sudo systemctl disable --now microduck-studio && sudo rm /etc/systemd/system/microduck-studio.service && sudo systemctl daemon-reload
# Resource limits are the same as during the trial: Studio must not compete with robotd for CPU (robotd is a 50 Hz control loop).
# Does not wait for network-online: Studio listens on 0.0.0.0, so it still accepts connections if the network comes up late; when the main program is absent, Studio waits and reconnects by itself.
[Unit]
Description=Microduck Studio（网页控制台，8000 端口）
After=network.target

[Service]
User=radxa
Group=radxa
WorkingDirectory=/home/radxa/studio-dev
ExecStart=/usr/bin/python3 -I run.py --listen 0.0.0.0:8000
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=20
CPUQuota=60%
MemoryMax=300M

[Install]
WantedBy=multi-user.target
